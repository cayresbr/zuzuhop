# Banco de dados. SQLite para desenvolvimento local.
# Em produção troque para PostgreSQL e ajuste o provider em prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Segredo usado para derivar chaves de tokens (troque em produção!)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="troque-este-valor-em-producao-com-no-minimo-32-caracteres"

# Origem pública da aplicação (usada na verificação anti-CSRF)
APP_ORIGIN="http://localhost:3000"

# Credenciais do primeiro administrador criadas pelo seed
SEED_ADMIN_EMAIL="admin@zuzuhop.com"
SEED_ADMIN_PASSWORD="Admin@123456"
